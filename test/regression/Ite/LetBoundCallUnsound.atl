{-# TEMPLATE [binom(2)] #-}

import Data.List

(**
 * The let-bound variant of CondCallUnsound, which was always rejected.
 *)

cmp : (x : a, c : List b) | binom (|c|) 1 -> (r : Bool) | 0
cmp x c = match c with
  | Nil -> True
  | (Cons z zs) -> ~ cmp x zs

g : (x : a, c : List b) | 0 -> (r : Bool) | 0
g x c = let b = cmp x c in if b then True else False

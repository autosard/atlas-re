{-# TEMPLATE [log(1,2), pot] #-}

import Data.List
import Pairing.Heap

(**
 * The pattern variable h has the same name as the result binder. The bound is
 * the one inferred for examples/Heap/PairingList.atl and must be provable.
 *)

merge_pairs : (hs : List (Hp a)) | pot hs + 5/2 * log(|hs|) -> (h : Heap a) | pot h
merge_pairs Nil = Empty
merge_pairs (Cons h1 t) = match t with
  | Nil -> Some h1
  | (Cons h2 hs) -> match ~ merge_pairs hs with
    | Empty -> Some (link h1 h2)
    | (Some h) -> Some (link (link h1 h2) h)
